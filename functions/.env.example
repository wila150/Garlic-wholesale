# 複製成 functions/.env（不會進 git）。金鑰不要放這裡，用 firebase functions:secrets:set 設定

# 老闆的登入 Email，多個用逗號隔開。這些帳號自動有全部權限，可以在後台「帳號」新增員工
OWNER_EMAILS=

# 商店資訊（印在出貨單、對帳單上）
SHOP_NAME=蒜頭行
SHOP_PHONE=
PAY_TERMS=款項月結，每月 10 日前付清上月貨款。
LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@257hxcms

# 截單：配送日前一天幾點；不配送的星期幾（0＝週日，可多個）
CUTOFF_HOUR=22
CLOSED_WEEKDAYS=

# 收「開通申請」通知的 LINE userId，多個用逗號隔開（對機器人傳「我的ID」拿到）
ADMIN_LINE_USER_IDS=

# 選填
LIFF_ID=
PUSH_ORDER_CONFIRM=
BASE_URL=

# 工程師：可以在後台「帳號」最下面用「重置測試資料」（測試期間用），其他人看不到
ENGINEER_EMAILS=
